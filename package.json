{
  "name": "qe-finance-pricing-and-reporting-automation",
  "version": "1.0.0",
  "description": "Playwright and TypeScript automation for AshleyNET Pricing regression",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:price-code": "playwright test --grep @price-code",
    "test:price-code:regression": "playwright test --grep \"@price-code.*@regression\"",
    "test:price-list": "playwright test tests/pricing/price-lists/price-list-maintenance.spec.ts",
    "test:price-list:regression": "playwright test tests/pricing/price-lists/price-list-maintenance.spec.ts --grep \"@price-list.*@regression\"",
    "test:update-queue": "playwright test tests/pricing/price-lists/price-list-update-queue.spec.ts",
    "test:update-queue:regression": "playwright test tests/pricing/price-lists/price-list-update-queue.spec.ts --grep \"@update-queue.*@regression\"",
    "test:buyer-group": "playwright test tests/pricing/price-lists/buyer-group-maintenance.spec.ts",
    "test:buyer-group:regression": "playwright test tests/pricing/price-lists/buyer-group-maintenance.spec.ts --grep \"@buyer-group.*@regression\"",
    "test:buyer-group-pricing": "playwright test tests/pricing/price-lists/buyer-group-pricing.spec.ts",
    "test:buyer-group-pricing:regression": "playwright test tests/pricing/price-lists/buyer-group-pricing.spec.ts --grep \"@buyer-group-pricing.*@regression\"",
    "test:buyer": "playwright test tests/pricing/price-lists/buyer-group-maintenance.spec.ts tests/pricing/price-lists/buyer-group-members.spec.ts tests/pricing/price-lists/buyer-group-defaults.spec.ts tests/pricing/price-lists/buyer-group-inactive.spec.ts tests/pricing/price-lists/buyer-group-forms.spec.ts tests/pricing/price-lists/buyer-group-pricing.spec.ts",
    "test:buyer-regression": "playwright test tests/pricing/price-lists/buyer-group-maintenance.spec.ts tests/pricing/price-lists/buyer-group-members.spec.ts tests/pricing/price-lists/buyer-group-defaults.spec.ts tests/pricing/price-lists/buyer-group-inactive.spec.ts tests/pricing/price-lists/buyer-group-forms.spec.ts tests/pricing/price-lists/buyer-group-pricing.spec.ts --grep @regression",
    "test:rate-validation": "playwright test tests/pricing/rate-validation-limits.spec.ts",
    "test:rate-validation:regression": "playwright test tests/pricing/rate-validation-limits.spec.ts --grep \"@rate-validation.*@regression\"",
    "test:master-code": "playwright test tests/Miscellaneous/master-code-maintenance.spec.ts",
    "test:master-code:regression": "playwright test tests/Miscellaneous/master-code-maintenance.spec.ts --grep \"@master-code.*@regression\"",
    "test:code-xref-master": "playwright test tests/Miscellaneous/code-xref-master.spec.ts",
    "test:code-xref-master:regression": "playwright test tests/Miscellaneous/code-xref-master.spec.ts --grep \"@code-xref-master.*@regression\"",
    "test:order-entry-specials": "playwright test tests/order-entry-specials/order-entry-specials.spec.ts",
    "test:order-entry-specials:regression": "playwright test tests/order-entry-specials/order-entry-specials.spec.ts --grep \"@order-entry-specials.*@regression\"",
    "test:order-entry-specials:smoke": "playwright test tests/order-entry-specials/order-entry-specials.spec.ts --grep \"@order-entry-specials.*@smoke\"",
    "test:expired-specials": "playwright test \"tests/expired specials/expired-specials.spec.ts\"",
    "test:expired-specials:regression": "playwright test \"tests/expired specials/expired-specials.spec.ts\" --grep \"@expired-specials.*@regression\"",
    "test:expired-specials:smoke": "playwright test \"tests/expired specials/expired-specials.spec.ts\" --grep \"@expired-specials.*@smoke\"",
    "test:price-exceptions": "playwright test \"tests/Price Exceptions/price-exceptions.spec.ts\"",
    "test:price-exceptions:regression": "playwright test \"tests/Price Exceptions/price-exceptions.spec.ts\" --grep \"@price-exceptions.*@regression\"",
    "test:price-exceptions:smoke": "playwright test \"tests/Price Exceptions/price-exceptions.spec.ts\" --grep \"@price-exceptions.*@smoke\"",
    "test:surcharge": "playwright test tests/surcharge",
    "test:surcharge:ui": "playwright test tests/surcharge/surcharge.spec.ts tests/surcharge/surcharge-ui-expansion.spec.ts",
    "test:surcharge:ui:regression": "playwright test tests/surcharge/surcharge.spec.ts tests/surcharge/surcharge-ui-expansion.spec.ts --grep \"@surcharge.*@regression\"",
    "test:surcharge:regression": "playwright test tests/surcharge --grep \"@surcharge.*@regression\"",
    "test:surcharge:smoke": "playwright test tests/surcharge/surcharge.spec.ts --grep \"@surcharge.*@smoke\"",
    "test:surcharge:contract": "playwright test tests/surcharge/surcharge-contract.spec.ts",
    "test:surcharge:api": "playwright test tests/surcharge/surcharge-api.spec.ts",
    "test:surcharge:inventory": "node scripts/validate-surcharge-inventory.cjs",
    "test:pricing-regression": "playwright test --grep @pricing-regression",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "typescript", "pricing", "regression"],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
